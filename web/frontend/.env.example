# ============================================================
# ACI 211 · Variables de entorno del frontend (estándar Vite)
# Copia este archivo como ".env" y rellena los valores.
# En producción también se configuran en Vercel > Settings > Environment Variables
# ============================================================

# --- API Python (FastAPI con el cerebro diseno_mezclas_aci211.py) ---
# URL pública donde vive la API desplegada (Railway/Render/Fly), SIN barra final.
# Ejemplo: https://api-aci211.up.railway.app
# En desarrollo local déjala VACÍA: el frontend usa el mismo origen
# (FastAPI sirve dist/ y la API en el puerto 8000).
VITE_API_URL=

# --- Supabase (andamiaje para Auth e historial de diseños) ---
# Panel de Supabase > Project Settings > API > Project URL y anon public key
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
